paintDotJs.registerPlugin({
    apiVersion: 1,
    id: "paintjs.example.channel-scale",
    name: "Channel Scale Example",
    author: "LabyStudio",
    version: "1.0.0",
    description: "Demonstrates a configurable paint.js pixel effect.",
    effects: [
        {
            id: "channel-scale",
            name: "Channel Scale",
            category: "Color",
            controls: [
                paintDotJs.controls.range("amount", "Amount", 0, 2, 1, 0.01),
                paintDotJs.controls.select("channel", "Channel", "red", [
                    ["red", "Red"],
                    ["green", "Green"],
                    ["blue", "Blue"]
                ])
            ],
            renderPixel({r, g, b, a, values}) {
                const channels = [r, g, b];
                const index = {red: 0, green: 1, blue: 2}[values.channel];
                channels[index] *= values.amount;
                return [channels[0], channels[1], channels[2], a];
            }
        }
    ]
});
